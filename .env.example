# Copy to apps/server/.env. Local Supabase defaults need no other settings.
# Seals the GitHub credentials saved in the dashboard (ADR-0004). Without it none can be saved.
# Generate one with: openssl rand -base64 32
SLOP_SECRET_KEY=
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_URL=http://127.0.0.1:54321
# SLOP_DATA_DIR=~/.slop-control is the default; use an absolute path here.

# Copy to apps/web/.env, using the values from `supabase status -o env`.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=
